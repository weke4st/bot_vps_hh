# ═══════════════════════════════════════════════════════════════════════════
# HH Auto-Apply Bot — Конфигурация окружения
# Скопируйте этот файл в .env и укажите ваш GIGACHAT_AUTH_KEY:
#   copy .env.example .env
# ═══════════════════════════════════════════════════════════════════════════

# ── Основные настройки ───────────────────────────────────────────────────
APP_NAME="HH Auto-Apply Bot"
DEBUG=false
LOG_LEVEL=INFO
API_TOKEN=changeme-to-a-random-string
JWT_SECRET=supersecret-random-jwt-key-replace-in-production

# ── Прокси для серверов за рубежом (Нидерланды VPS) ───────────────────────
# Если сервер находится в Европе, hh.ru и Сбербанк будут блокировать доступ.
# Укажите российский HTTP или SOCKS5 прокси (пользователи могут также задать личный прокси в профиле):
# DEFAULT_PROXY=http://user:pass@ru-proxy-ip:port
DEFAULT_PROXY=

# ── База данных ──────────────────────────────────────────────────────────
# SQLite по умолчанию (автоматически включается режим WAL):
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# ── Браузер ──────────────────────────────────────────────────────────────
# headless=true — фоновый режим, false — видимый браузер для отладки
HEADLESS=true
USER_DATA_DIR=data/session

# ── Поиск вакансий на hh.ru ──────────────────────────────────────────────
SEARCH_QUERY="DevOps"
# Резервный регион (1 - Москва, 113 - вся Россия, 2 - Санкт-Петербург)
SEARCH_REGION=113
# SALARY_FROM=150000
# EXPERIENCE=between1And3
# WORK_FORMAT=remote

# ── Лимиты и паузы ───────────────────────────────────────────────────────
# Максимум откликов в час (рекомендуется не более 20)
MAX_APPLICATIONS_PER_HOUR=20
# Максимум откликов в день (на hh.ru суточный лимит 200)
MAX_APPLICATIONS_PER_DAY=190
# Задержка между откликами (в секундах, мин. 15 сек для защиты от бана)
MIN_DELAY_BETWEEN_APPLIES_SEC=15
MAX_DELAY_BETWEEN_APPLIES_SEC=30
# Интервал запуска цикла поиска (в минутах)
SEARCH_INTERVAL_MINUTES=5

# ── Нейросеть (LLM) для писем и тестов ───────────────────────────────────
# Варианты: gigachat, deepseek
LLM_PROVIDER=gigachat

# GigaChat (https://developers.sber.ru/)
# 1. Зарегистрируйтесь на https://developers.sber.ru/
# 2. Создайте проект GigaChat API
# 3. Скопируйте "Авторизационные данные" (Base64 строка) и вставьте ниже:
GIGACHAT_AUTH_KEY=your_gigachat_authorization_key_base64_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_MODEL=GigaChat
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth

# DeepSeek (резервный провайдер)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Параметры генерации
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=600

# ── Распознавание CAPTCHA ────────────────────────────────────────────────
# Локальный endpoint (если запущен llama-server)
OCR_ENDPOINT=http://localhost:8080/v1
OCR_MODEL=PaddleOCR-VL-0.9B
OCR_MAX_RETRIES=3

# ── Настройки поведения человека (мимикрия) ──────────────────────────────
TYPING_MEAN_MS=120
TYPING_STD_MS=35
TYPO_RATE=0.015
SCROLL_PAUSE_MIN=0.3
SCROLL_PAUSE_MAX=1.2
ACTION_PAUSE_MEAN=3.0
MISS_CLICK_RATE=0.03
