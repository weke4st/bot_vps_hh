[Unit]
Description=HH Auto-Apply Bot (FastAPI + Patchright + APScheduler)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/hh-bot
Environment="PATH=/home/ubuntu/hh-bot/.venv/bin"
EnvironmentFile=/home/ubuntu/hh-bot/.env
ExecStart=/home/ubuntu/hh-bot/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
